diff --git a/dist/converters/responses.cjs b/dist/converters/responses.cjs
index 8e4544d..9c5f87b 100644
--- a/dist/converters/responses.cjs
+++ b/dist/converters/responses.cjs
@@ -912,13 +912,25 @@ const convertMessagesToResponsesInput = ({ messages, zdrEnabled, model }) => {
